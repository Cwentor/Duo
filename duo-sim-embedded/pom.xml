<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.duo</groupId>
        <artifactId>duo-sim-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>duo-sim-embedded</artifactId>
    <name>Duo Sim embedded</name>
    <dependencies>
        <dependency>
            <groupId>io.duo</groupId>
            <artifactId>duo-sim-kernel</artifactId>
        </dependency>
        <!-- embedded 档：JVM 内真实第三方协议实现 -->
        <dependency>
            <groupId>org.apache.curator</groupId>
            <artifactId>curator-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
        </dependency>
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-server-mock</artifactId>
            <version>6.13.4</version>
            <exclusions>
                <!-- 避免与项目 JUnit 版本冲突（T24 同类问题） -->
                <exclusion>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>junit-platform-commons</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- container 档（M4 T38）：Testcontainers 桥（§6：本地 Docker 按需拉起真容器） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>1.20.4</version>
        </dependency>
        <!-- 显式钉住 jackson-annotations：testcontainers→docker-java 传递 2.10.3，
             会胜过 fabric8 mock 需要的 2.17+（JsonKey 在 2.17 才有，否则 NoClassDefFound） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.18.2</version>
        </dependency>
        <dependency>
            <groupId>org.apache.curator</groupId>
            <artifactId>curator-test</artifactId>
            <!-- curator-test 传递 junit-jupiter-api 5.6.2，与项目的 5.11.4 冲突
                 （surefire 测试发现失败）；排除后由父 pom 统一版本 -->
            <exclusions>
                <exclusion>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>junit-platform-commons</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
