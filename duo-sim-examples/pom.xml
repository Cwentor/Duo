<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.duo</groupId>
        <artifactId>duo-sim-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>duo-sim-examples</artifactId>
    <name>Duo Sim examples</name>
    <dependencies>
        <dependency>
            <groupId>io.duo</groupId>
            <artifactId>duo-sim-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.duo</groupId>
            <artifactId>duo-sim-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>io.duo</groupId>
            <artifactId>duo-sim-components</artifactId>
        </dependency>
        <dependency>
            <groupId>io.duo</groupId>
            <artifactId>duo-sim-scenario</artifactId>
        </dependency>
        <!-- M2：M2 验收场景用 embedded 档（Curator TestingServer 等） -->
        <dependency>
            <groupId>io.duo</groupId>
            <artifactId>duo-sim-embedded</artifactId>
        </dependency>
        <!-- 第 14 轮口径修正：DuoCliTest 是**编排层**用例——它加载的场景里 SUT 就是本模块的
             DemoScheduler（launch.main 指向本模块类），故它属于本模块的测试，留在本模块
             src/test 里按模块归属执行（控制面自身的契约测试已回到 duo-sim-control）。 -->
        <dependency>
            <groupId>io.duo</groupId>
            <artifactId>duo-sim-control</artifactId>
        </dependency>
        <dependency>
            <groupId>io.duo</groupId>
            <artifactId>duo-sim-junit</artifactId>
        </dependency>
        <!-- D1：demo-scheduler 作为真实 SUT 用 ZK 客户端连 embedded registry（wire 路径） -->
        <dependency>
            <groupId>org.apache.curator</groupId>
            <artifactId>curator-framework</artifactId>
        </dependency>
        <!-- M8 观测面：本模块是 CLI/REST 的端到端宿主，「日志有后端」必须是本模块自身的
             契约而不是传递依赖的偶然（embedded 也带 classic，Maven 就近原则取本声明）。 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <!-- M9：DsFailoverAcceptanceTest 的 DS OpenAPI 编排层直用 jackson-databind
             （ObjectMapper/JsonNode 解析 DS 响应）。依赖门禁第 11 轮口径：直接 import 的
             坐标必须显式声明（门禁豁免表只放行 annotations/core 聚合分体件，不放行
             databind）——此前经 control 传递偶得、e80deb4 引入首个直接 import 后 CI 门禁红。
             仅测试代码使用，scope=test。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
