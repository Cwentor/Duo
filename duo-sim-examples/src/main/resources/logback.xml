<?xml version="1.0" encoding="UTF-8"?>
<!--
  Duo 默认日志配置（M8 观测面：交付物 2）。

  三条通道的分工（设计 §11）：
    ① 事件流录制（events.jsonl）——**机器可校验的事实源**，断言与指标都读它；
    ② 日志（本文件）——**人可读的因果链**：谁在什么时候对谁做了什么、为什么失败；
    ③ /metrics——**可聚合的数值**（Prometheus）。三者互补，不互相替代。

  默认行为（可读优先）：
    - 控制台按 `时间 级别 [线程] logger - 消息` 输出，Duo 自身包默认 INFO；
    - 第三方库（ZK/Curator/Netty/Testcontainers/H2/K8s mock）默认 WARN——
      它们在 INFO 下会刷屏，把 Duo 的因果链淹没（"默认可用"的关键取舍）；
    - 故障注入相关事件走 `io.duo.sim.fault` logger，默认 INFO 且带固定前缀，
      便于 `grep FAULT` 直接捞出一次注入的完整轨迹（M8 交付物 3 的入口）。

  可选开关（均为 JVM 系统属性，CLI 直接透传）：
    - `-Dduo.log.level=DEBUG`  改 root 级别（默认 INFO）；
    - `-Dduo.log.json=INFO`    额外挂 JSON 出口（默认 OFF）。

  **本文件刻意不做"条件配置"**：logback 1.5.16 的条件块（condition 标记）依赖隐式栈
  （ElseModelHandler → peekModel），在本项目配置形态下实测抛 EmptyStackException，
  直接导致 LoggerContext 初始化失败——"日志后端不可用"远比"格式不可选"严重。
  条件选择因此改用 `${属性:-默认值}` 占位符，行为可预测且可测。
-->
<configuration>
    <property name="DUO_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${DUO_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 结构化出口：每行一个 JSON 对象（不引 logstash-logback-encoder，
         零新增依赖——与 D4「零依赖手写 /metrics」同一原则），字段顺序固定。 -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>{"ts":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%level","thread":"%thread","logger":"%logger","msg":"%replace(%msg){'([\\"\\\\])','\\\\$1'}"}%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Duo 自身：显式 INFO（即便未来有人给 root 加 appender，Duo 通道保持稳定） -->
    <logger name="io.duo.sim" level="${duo.log.level:-INFO}"/>

    <!-- JSON 出口挂在 io.duo.sim 的**子**记录器上，默认 OFF：开启时 Duo 日志同时
         进 CONSOLE 与 JSON；未开启时该记录器 OFF，不产生任何额外输出。 -->
    <logger name="io.duo.sim.json" level="${duo.log.json:-OFF}" additivity="false">
        <appender-ref ref="JSON"/>
    </logger>

    <!-- 第三方降噪：不静默（WARN 及以上仍可见），只是不抢占 INFO 视野 -->
    <logger name="org.apache.zookeeper" level="WARN"/>
    <logger name="org.apache.curator" level="WARN"/>
    <logger name="org.apache.zookeeper.ClientCnxn" level="ERROR"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.testcontainers" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>
    <logger name="org.testcontainers.shaded" level="WARN"/>
    <logger name="com.h2database" level="WARN"/>
    <logger name="io.fabric8" level="WARN"/>
    <logger name="okhttp3" level="WARN"/>

    <!-- 故障注入因果链：固定 logger 名 + 固定前缀，便于单命令捞出一次注入的全过程 -->
    <logger name="io.duo.sim.fault" level="INFO"/>
</configuration>
