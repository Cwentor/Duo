<?xml version="1.0" encoding="UTF-8"?>
<!--
  测试期日志配置（M8 / G6 观测面）。

  **为什么要单独一份**：`duo-sim-examples` 的 main 资源里有生产用 logback.xml，
  一旦被测试类路径加载，全量回归会变成几千行日志（T7「秒级反馈回路」直接受损），
  而 CI 上真正需要看见的是**失败时的因果链**。因此测试档：
    - 根级别 WARN（默认安静）；
    - 例外：`io.duo.sim.fault`（注入事实）保持 INFO，
      `io.duo.sim.control.metrics`（指标口径）保持 INFO；
    - 需要全量日志时传 `-Dduo.test.verbose=true`（root 提 DEBUG）。

  文件名 logback-test.xml 是 logback 的**测试约定名**（优先于 logback.xml），
  Maven 的 target/test-classes 天然排在 target/classes 之前，无需任何 surefire 配置。

  **为什么不做"条件配置"**：logback 1.5.16 的条件块依赖一个隐式栈
  （``ElseModelHandler`` 走 `peekModel`），实测在本项目的配置形态下会抛
  `EmptyStackException` 并让整个 LoggerContext 初始化失败——**日志后端直接不可用**，
  比"日志刷屏"严重得多。这里改用两种都稳的形态：
    1. 属性占位符决定 root 级别（`${DUO_TEST_LEVEL:-WARN}`，可用系统属性覆盖）；
    2. 两个 appender 并存，由 root 级别统一控制过滤。
-->
<configuration>
    <!-- 系统属性 > 默认值：-Dduo.test.verbose=true 时提为 DEBUG -->
    <property name="DUO_TEST_LEVEL"
              value="${duo.test.rootLevel:-${duo.test.verbose:+DEBUG}}"/>
    <property name="DUO_TEST_ROOT"
              value="${DUO_TEST_LEVEL:-WARN}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="${DUO_TEST_ROOT}">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- 注入事实与指标口径：测试期也要看得见（降噪不得静默因果链，§12） -->
    <logger name="io.duo.sim.fault" level="INFO"/>
    <logger name="io.duo.sim.control.metrics" level="INFO"/>

    <!-- 第三方降噪（比生产档更严：ZK 的 INFO 会淹没 Duo 的因果链） -->
    <logger name="org.apache.zookeeper" level="ERROR"/>
    <logger name="org.apache.curator" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.testcontainers" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>
    <logger name="com.h2database" level="WARN"/>
    <logger name="io.fabric8" level="WARN"/>
    <logger name="okhttp3" level="WARN"/>
</configuration>
